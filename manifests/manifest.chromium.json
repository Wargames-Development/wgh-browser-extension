{
  "manifest_version": 3,
  "name": "WGH Browser Extension",
  "version": "0.1.0",
  "description": "User-initiated browser workflows for Wargames Hosting and Wargames Solder.",
  "host_permissions": [
    "https://solder.wargames.localhost/*",
    "https://*.wargames.localhost/*",
    "https://*.wargames.host/*",
    "https://*.wargames.uk/*",
    "https://www.technicpack.net/modpack/edit/*/versions",
    "https://www.technicpack.net/modpack/*/updates"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://solder.wargames.localhost/*",
        "https://*.wargames.localhost/*",
        "https://*.wargames.host/*",
        "https://*.wargames.uk/*"
      ],
      "js": [
        "src/bridge/wargames-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.technicpack.net/modpack/edit/*/versions",
        "https://www.technicpack.net/modpack/*/updates"
      ],
      "js": [
        "src/technic/changelog-publisher.js",
        "src/technic/update-publisher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_title": "WGH Browser Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png"
    }
  }
}

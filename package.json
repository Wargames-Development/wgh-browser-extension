{
  "name": "wgh-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for user-confirmed Wargames Hosting workflows that post Technic changelogs and update/status messages from Wargames Solder without storing Technic credentials.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:chromium": "node scripts/build.js chromium",
    "build:firefox": "node scripts/build.js firefox",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "wargames-hosting",
    "wargames-solder",
    "browser-extension",
    "webextension",
    "technic",
    "changelog",
    "update-publisher",
    "chrome-extension",
    "firefox-extension",
    "edge-extension",
    "opera-gx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wargames-Development/wgh-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Wargames-Development/wgh-browser-extension/issues"
  },
  "homepage": "https://github.com/Wargames-Development/wgh-browser-extension#readme"
}
